{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hangtian:case-record-sidecar:1",
  "title": "Private case curation sidecar; NOT the runtime CASE contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "status", "case_type", "family_id", "parent_case_ids", "source_hashes", "source_artifacts", "scene", "windows", "facts", "claims", "limitations", "distinction", "public_scope", "verification", "review"],
  "properties": {
    "schema_version": {"const": "case-record-sidecar-1"},
    "case_id": {"type": "string", "pattern": "^C[0-9]{4,}$"},
    "status": {"enum": ["candidate", "needs_evidence", "accepted", "rejected", "merged"]},
    "case_type": {"enum": ["single_source", "comparison", "quality"]},
    "family_id": {"type": "string", "minLength": 1},
    "parent_case_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "source_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "source_artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["telemetry_sha256", "context_sha256", "label_sha256", "alignment"], "properties": {
      "telemetry_sha256": {"$ref": "#/$defs/hash"},
      "context_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
      "label_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
      "alignment": {"enum": ["rowwise_exact_time", "telemetry_only", "unverified"]}
    }}},
    "scene": {"type": "string", "minLength": 1},
    "windows": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_sha256", "rows", "role", "selection_reason"], "properties": {
      "source_sha256": {"$ref": "#/$defs/hash"}, "rows": {"$ref": "#/$defs/rows"},
      "role": {"enum": ["whole_process", "before", "transition", "after", "reference", "counterexample"]},
      "selection_reason": {"type": "string", "minLength": 1}
    }}},
    "facts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["fact_id", "source_sha256", "rows", "channels", "operation", "parameters", "result", "unit", "verification_status"], "properties": {
      "fact_id": {"type": "string", "minLength": 1}, "source_sha256": {"$ref": "#/$defs/hash"}, "rows": {"$ref": "#/$defs/rows"},
      "channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "operation": {"type": "string", "minLength": 1}, "parameters": {"type": "object"},
      "result": {}, "unit": {"type": ["string", "null"]},
      "verification_status": {"enum": ["pending", "passed", "failed"]}
    }}},
    "claims": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["statement", "verdict", "fact_ids", "scope_and_limits"], "properties": {
      "statement": {"type": "string", "minLength": 1}, "verdict": {"enum": ["supported", "refuted", "insufficient", "untested"]},
      "fact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
      "scope_and_limits": {"type": "string", "minLength": 1}
    }}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "distinction": {"type": "object", "additionalProperties": false, "required": ["disposition", "nearest_case_ids", "merge_into", "reason"], "properties": {
      "disposition": {"enum": ["unreviewed", "core", "variant", "duplicate"]},
      "nearest_case_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
      "merge_into": {"type": ["string", "null"]}, "reason": {"type": "string", "minLength": 1}
    }},
    "public_scope": {"type": "object", "additionalProperties": false, "required": ["record_selection", "neutral_context", "leakage_review"], "properties": {
      "record_selection": {"type": "array", "items": {"type": "string"}},
      "neutral_context": {"type": "array", "items": {"type": "string"}},
      "leakage_review": {"enum": ["pending", "passed", "failed"]}
    }},
    "verification": {"type": "object", "additionalProperties": false, "required": ["status", "report_file", "report_sha256", "method"], "properties": {
      "status": {"enum": ["pending", "passed", "failed"]},
      "report_file": {"type": ["string", "null"]},
      "report_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
      "method": {"type": "string", "minLength": 1}
    }},
    "review": {"type": "object", "additionalProperties": false, "required": ["decision", "reviewed_content_sha256", "reviewer", "independence", "blocking_issues", "rationale"], "properties": {
      "decision": {"enum": ["pending", "accept", "needs_evidence", "merge", "reject"]},
      "reviewed_content_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
      "reviewer": {"type": ["string", "null"]}, "independence": {"type": "string"},
      "blocking_issues": {"type": "array", "items": {"type": "string"}}, "rationale": {"type": "string"}
    }}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rows": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}}
  }
}
