{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "max_rows": {
      "type": "integer",
      "minimum": 1
    },
    "max_cases": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "max_revisions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "task_language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "max_api_calls": {
      "type": "integer",
      "minimum": 1
    },
    "transport_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "max_input_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "models": {
      "type": "object",
      "properties": {
        "case_curator": {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "api_key_env": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 256,
              "maximum": 32768
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          },
          "required": [
            "base_url",
            "api_key_env",
            "model",
            "max_tokens",
            "temperature"
          ],
          "additionalProperties": false
        },
        "task_generator": {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "api_key_env": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 256,
              "maximum": 32768
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          },
          "required": [
            "base_url",
            "api_key_env",
            "model",
            "max_tokens",
            "temperature"
          ],
          "additionalProperties": false
        },
        "task_critic": {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "api_key_env": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 256,
              "maximum": 32768
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          },
          "required": [
            "base_url",
            "api_key_env",
            "model",
            "max_tokens",
            "temperature"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "case_curator",
        "task_generator",
        "task_critic"
      ],
      "additionalProperties": false
    },
    "mining": {
      "type": "object",
      "properties": {
        "window_rows": {
          "type": "integer",
          "minimum": 1
        },
        "noise_multiplier": {
          "type": "number",
          "minimum": 0
        },
        "group_gap_rows": {
          "type": "integer",
          "minimum": 0
        },
        "max_group_span_rows": {
          "type": "integer",
          "minimum": 1
        },
        "context_rows": {
          "type": "integer",
          "minimum": 1
        },
        "max_channels": {
          "type": "integer",
          "minimum": 1
        },
        "context_channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "minItems": 1,
          "maxItems": 200
        },
        "zero_channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "minItems": 0,
          "maxItems": 200
        },
        "zero_epsilon": {
          "type": "number",
          "minimum": 0
        },
        "min_zero_rows": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "min_step": {
                "type": "number",
                "minimum": 0
              },
              "min_spike": {
                "type": "number",
                "minimum": 0
              },
              "neighbor_tolerance": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "min_step",
              "min_spike",
              "neighbor_tolerance"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "window_rows",
        "noise_multiplier",
        "group_gap_rows",
        "max_group_span_rows",
        "context_rows",
        "max_channels",
        "context_channels",
        "zero_channels",
        "zero_epsilon",
        "min_zero_rows",
        "channels"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "max_rows",
    "max_cases",
    "max_revisions",
    "task_language",
    "max_api_calls",
    "transport_retries",
    "timeout_seconds",
    "max_input_bytes",
    "max_response_bytes",
    "models",
    "mining"
  ],
  "additionalProperties": false
}
