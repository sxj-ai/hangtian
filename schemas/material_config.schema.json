{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "max_api_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "max_solver_steps": {
      "type": "integer",
      "minimum": 2,
      "maximum": 12
    },
    "max_revisions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "transport_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "max_input_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "review_mode": {
      "type": "string",
      "enum": [
        "api",
        "assistant"
      ]
    },
    "models": {
      "type": "object",
      "properties": {
        "material_generator": {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "api_key_env": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 256,
              "maximum": 32768
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "thinking": {
              "type": "string",
              "enum": [
                "enabled",
                "disabled"
              ]
            },
            "reasoning_effort": {
              "type": "string",
              "enum": [
                "low",
                "high",
                "max"
              ]
            }
          },
          "required": [
            "base_url",
            "api_key_env",
            "model",
            "max_tokens",
            "temperature"
          ],
          "additionalProperties": false
        },
        "material_critic": {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "api_key_env": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 256,
              "maximum": 32768
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "thinking": {
              "type": "string",
              "enum": [
                "enabled",
                "disabled"
              ]
            },
            "reasoning_effort": {
              "type": "string",
              "enum": [
                "low",
                "high",
                "max"
              ]
            }
          },
          "required": [
            "base_url",
            "api_key_env",
            "model",
            "max_tokens",
            "temperature"
          ],
          "additionalProperties": false
        },
        "material_solver": {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "api_key_env": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 256,
              "maximum": 32768
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "thinking": {
              "type": "string",
              "enum": [
                "enabled",
                "disabled"
              ]
            },
            "reasoning_effort": {
              "type": "string",
              "enum": [
                "low",
                "high",
                "max"
              ]
            }
          },
          "required": [
            "base_url",
            "api_key_env",
            "model",
            "max_tokens",
            "temperature"
          ],
          "additionalProperties": false
        },
        "material_judge": {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "api_key_env": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 256,
              "maximum": 32768
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "thinking": {
              "type": "string",
              "enum": [
                "enabled",
                "disabled"
              ]
            },
            "reasoning_effort": {
              "type": "string",
              "enum": [
                "low",
                "high",
                "max"
              ]
            }
          },
          "required": [
            "base_url",
            "api_key_env",
            "model",
            "max_tokens",
            "temperature"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "material_generator",
        "material_critic",
        "material_solver",
        "material_judge"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "max_api_calls",
    "max_solver_steps",
    "max_revisions",
    "transport_retries",
    "timeout_seconds",
    "max_input_bytes",
    "max_response_bytes",
    "models"
  ],
  "additionalProperties": false
}
