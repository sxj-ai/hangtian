{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
            },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": [
          "claim",
          "observation_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 30
    },
    "conclusion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 6000
      },
      "minItems": 0,
      "maxItems": 20
    }
  },
  "required": [
    "findings",
    "conclusion",
    "limitations"
  ],
  "additionalProperties": false
}
